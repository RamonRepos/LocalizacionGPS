{
  "name": "localizaciongps",
  "version": "0.1.0",
  "description": "Etiquetas QR imprimibles para compartir la ubicación de mascotas y objetos perdidos",
  "main": "src/worker.js",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "desplegar": "wrangler deploy",
    "db:local": "wrangler d1 execute localizacion-db --local --file=./esquema.sql",
    "db:remoto": "wrangler d1 execute localizacion-db --remote --file=./esquema.sql"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^5.2.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "wrangler": "^4.148.0"
  }
}
